# Copie este arquivo para .env e ajuste os valores.

# SQLite local (padrão). Para Postgres use algo como:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/viverbem"
DATABASE_URL="file:./dev.db"

# Segredo do cookie de sessão do admin — mínimo 32 caracteres, use um valor aleatório
SESSION_SECRET="troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"
